# ============================================================
#  PLANTILLA — copie este archivo como:
#      application-local.properties
#  y complete su clave. El archivo real está excluido del
#  repositorio por .gitignore y NO debe subirse nunca.
#
#  Comando (desde backend/src/main/resources/):
#      copy application-local.properties.ejemplo application-local.properties
# ============================================================

spring.datasource.username=sgpj_app
spring.datasource.password=CAMBIE-ESTA-CLAVE

# --- Solo para desarrollo local ------------------------------
# Muestra el SQL que ejecuta Hibernate. Útil mientras se construye;
# se apaga en cualquier otro entorno.
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Detalle de las migraciones de Flyway al arrancar
logging.level.org.flywaydb=INFO

# Muestra el error completo en consola durante el desarrollo
logging.level.co.iuris.sgpj=DEBUG

# --- Administrador de Plataforma inicial ---------------------
# Sin esto nadie puede entrar: la seguridad esta activa y el primer
# usuario debe existir antes de poder autenticarse. Si no se define,
# la aplicacion arranca pero avisa de que nadie podra iniciar sesion.
# NO hay contrasena por defecto, a proposito.
sgpj.administrador-inicial.correo=CAMBIE-ESTE-CORREO
sgpj.administrador-inicial.contrasena=CAMBIE-ESTA-CLAVE
sgpj.administrador-inicial.nombre=Administrador de Plataforma

# --- Cifrado de documentos (RNF-04) --------------------------
# Clave AES-256 en Base64. Sin ella la aplicacion NO arranca, a
# proposito: no hay clave por defecto porque estaria en el repositorio.
# Generar:  openssl rand -base64 32
sgpj.documentos.clave=CAMBIE-ESTA-CLAVE-BASE64-DE-32-BYTES
