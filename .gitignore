# --- Secretos y configuración local (estándar 1 de D-21) ---
.env
.env.*
!.env.example
*-local.properties
*-local.yml
application-local.properties
application-local.yml
application-secrets.*
# La plantilla SI se versiona: documenta los nombres, no los valores
!application-local.properties.ejemplo
*.pem
*.key
*.p12
*.jks
# Ficheros que CONTIENEN credenciales. Sin comodin al final, a proposito:
# «credenciales*» se comia credenciales.interceptor.ts -codigo fuente, no un
# secreto- y el repositorio dejaba de poder compilarse desde cero sin que
# nada lo dijera. Se descubrio clonandolo en el VPS para desplegar.
credenciales.json
credenciales.txt
credenciales.env
credenciales.yml
credenciales.yaml
credenciales.properties
secretos.json
secretos.txt
secretos.env
secretos.yml
secretos.yaml
secretos.properties

# --- Java / Maven ---
target/
build/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
!maven-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

